# Local: npm ci; npm run build; npm start (set APP_ORIGIN=http://localhost:3000)
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DB_PATH=data/outpost.sqlite
ROUND_SECONDS=40
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# WalletConnect Cloud public project ID enables RainbowKit mobile wallets.
VITE_CHAIN_ID=46630
VITE_WALLETCONNECT_PROJECT_ID=
# Optionally replace public browser RPCs with your provider endpoints.
VITE_TESTNET_RPC_URL=
VITE_MAINNET_RPC_URL=
# Leave checkout disabled until deployed. Never put private keys in VITE_* variables.
STORE_ADDRESS=
TOKEN_ADDRESS=
STABLE_ADDRESS=
TOKEN_DECIMALS=18
STABLE_DECIMALS=6
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_SIGNER_ADDRESS=
OWNER_ADDRESS=
TREASURY_ADDRESS=
DEPLOYER_PRIVATE_KEY=
CONFIRMATIONS=3
# Worthless TESTNET mocks only: merchant tariff, not market price.
TOKEN_UNITS_PER_DOLLAR=
# Mainnet RIVAL checkout stays disabled without fresh price feed, bounds,
# o1 indexed market cross-check, and sufficient pool liquidity.
# See docs/PRICING.md for response schema and operational requirements.
RIVAL_PRICE_URL=
RIVAL_MIN_PRICE_USD=
RIVAL_MAX_PRICE_USD=
O1_READ_API_KEY=
MIN_POOL_LIQUIDITY_USD=50000
# scenario (default) or robinhood. Failed live feed becomes neutral.
MARKET_MODE=scenario
MARKET_SYMBOL=NVDA
# o1 unsigned launch preparation; never available in browser.
O1_API_KEY=
LAUNCH_CREATOR=
PUBLIC_WEBSITE=
TOKEN_IMAGE=public/token.png
